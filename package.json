{
  "name": "nutrio-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=web/src/domain/** --coverage.include=web/src/storage/** --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80",
    "test:watch": "vitest",
    "check:content": "node tools/check-content.mjs",
    "check:legacy": "node tools/check-legacy.mjs",
    "check:pwa": "node tools/pwa-check-dist.mjs",
    "check:pwa:dist": "node tools/pwa-check-dist.mjs",
    "smoke:dist": "node tools/dist-smoke.mjs",
    "e2e": "node tools/e2e-react.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:coverage && npm run build && npm run check:content && npm run check:legacy && npm run check:pwa:dist && npm run smoke:dist",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:content && npm run check:pwa:dist && npm run smoke:dist"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
